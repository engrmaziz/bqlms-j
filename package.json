{
	"name": "lms-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:int": "vitest run -c vitest.int.config.ts --passWithNoTests",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "tsx src/db/seed.ts",
		"jobs:dev": "tsx scripts/jobs-dev.ts",
		"verify": "pnpm run typecheck && pnpm run lint && pnpm run depcruise && pnpm run test && pnpm run test:int",
		"depcruise": "depcruise src",
		"ci:prepare": "echo \"ci:prepare no-op\""
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.53.0",
		"next": "16.4.0",
		"pino": "^10.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shadcn": "^4.21.4",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.0",
		"@tailwindcss/turbopack": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"dependency-cruiser": "^18.5.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.0",
		"pino-pretty": "^13.2.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@10.30.3"
}
